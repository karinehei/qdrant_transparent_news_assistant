LLM_PROVIDER=vllm
VLLM_BASE_URL=http://vllm:8001
VLLM_MODEL=microsoft/Phi-3-mini-4k-instruct

# Qdrant
# For Docker: docker-compose.yml uses http://qdrant:6333
# For local dev: use http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=news_chunks

# Audit DB
# For Docker: docker-compose.yml uses PostgreSQL
# For local dev: use SQLite
AUDIT_DB_URL=sqlite:///./audit.db

RELEVANCE_THRESHOLD=0.30
